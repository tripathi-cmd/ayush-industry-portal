# SkillConnect Backend Configuration

# Server Port
PORT=5000

# JWT Secret Key
JWT_SECRET=skillconnect-secure-jwt-token-key-2026

# MongoDB Atlas Connection (Cloud Database)
# Sign up free at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/skillconnect

# Environment
NODE_ENV=development

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Optional: Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
